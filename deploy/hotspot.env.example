# Copy to deploy/hotspot.env (git-ignored) and edit. Read by setup_hotspot.sh.
# Plain KEY=value lines; wrap the value in double quotes if it contains
# spaces or shell characters ($ ` " \ !).
#
# This is the Wi-Fi password phones use to join the AGV. It is NOT the
# dashboard password (.dashboard_password) and the two must stay separate.

HOTSPOT_SSID="AGV-Bekart"
# WPA2 passphrase, 8-63 characters.
HOTSPOT_PASSWORD=""
# Wi-Fi interface from `nmcli device` (type "wifi"). Leave empty only if the
# Jetson has exactly one Wi-Fi device; the script then uses that one.
HOTSPOT_IFACE=""
# NetworkManager connection name (the profile this script owns).
HOTSPOT_CON_NAME="agv-hotspot"
# "bg" = 2.4 GHz (best phone compatibility), "a" = 5 GHz. Empty = NM default.
HOTSPOT_BAND="bg"
